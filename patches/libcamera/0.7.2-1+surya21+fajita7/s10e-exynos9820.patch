+/*
+ * sharpness10P() on 10-bit unpacked Bayer (2 bytes a pixel, little endian, as the Exynos 9820 CSIS write DMA
+ * stores it): the same 4x4 blocks of the top 8 bits, so the focus measure and its tuning carry over.
+ */
+void SwStatsCpu::sharpness10(const uint8_t *frame, SwIspStats &stats)
+{
+	const unsigned int w = window_.width, h = window_.height;
+	const unsigned int x0 = (window_.x + w / 3) & ~3u, x1 = (window_.x + 2 * w / 3) & ~3u;
+	const unsigned int y0 = (window_.y + h / 3) & ~1u, y1 = window_.y + 2 * h / 3;
+	uint64_t sum = 0, level = 0;
+	uint32_t count = 0;
+
+	static const std::array<uint16_t, 16 * 255 + 1> kRoot = [] {
+		std::array<uint16_t, 16 * 255 + 1> t{};
+		for (unsigned int i = 0; i < t.size(); i++)
+			t[i] = static_cast<uint16_t>(std::lround(16.0 * std::sqrt(static_cast<double>(i))));
+		return t;
+	}();
+	auto block = [&](const uint8_t *p) {
+		int t = 0;
+		for (unsigned int r = 0; r < 4; r++, p += stride_) {
+			const uint16_t *q = reinterpret_cast<const uint16_t *>(p);
+			t += (q[0] >> 2) + (q[1] >> 2) + (q[2] >> 2) + (q[3] >> 2);
+		}
+		return static_cast<int>(kRoot[std::min(t, 16 * 255)]);
+	};
+	for (unsigned int y = y0; y + 8 <= y1; y += 8) {
+		const uint8_t *row = frame + y * stride_;
+		const uint8_t *below = row + 4 * stride_;
+		for (unsigned int x = x0; x + 8 <= x1; x += 4) {
+			const int c = block(row + 2 * x);
+			const int dh = c - block(row + 2 * (x + 4)), dv = c - block(below + 2 * x);
+			sum += dh * dh + dv * dv;
+			level += c;
+			count += 6;
+		}
+	}
+	stats.sharpness += sum;
+	stats.sharpnessCount += count;
+	stats.sharpnessLevel += level;
 }
 
 /*
@@ -735,6 +781,8 @@
 		/* autofocus wants its measure on every frame: a lens step then takes 3 frames instead of 4-8 */
 		if (sharpness10P_)
 			sharpness10P(input.planes()[0].data(), stats_[0]);
+		else if (sharpness10_)
+			sharpness10(input.planes()[0].data(), stats_[0]);
 		finishFrame(frame, bufferId);
 		return;
