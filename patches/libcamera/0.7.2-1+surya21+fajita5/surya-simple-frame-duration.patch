+/*
+ * FrameDurationLimits as the sensor's frame length: its maximum duration over the configured mode's line time,
+ * clamped to what the mode allows, set as VBLANK (the sensor drivers write the frame length from it).
+ */
+void SimpleCameraData::applyFrameDuration(const ControlList &controls)
+{
+	const auto &limits = controls.get(controls::FrameDurationLimits);
+	if (!limits)
+		return;
+
+	const int64_t us = (*limits)[1];
+	if (us <= 0 || us == frameDurationUs_)
+		return;
+
+	IPACameraSensorInfo info;
+	if (sensor_->sensorInfo(&info) || !info.pixelRate || !info.minLineLength)
+		return;
+
+	const double line = static_cast<double>(info.minLineLength) / info.pixelRate;
+	int64_t frame = std::llround(us * 1e-6 / line);
+	frame = std::clamp<int64_t>(frame, info.minFrameLength, info.maxFrameLength);
+
+	ControlList ctrls(sensor_->controls());
+	ctrls.set(V4L2_CID_VBLANK, static_cast<int32_t>(frame - info.outputSize.height));
+	if (sensor_->setControls(&ctrls))
+		return;
+
+	frameDurationUs_ = us;
+	LOG(SimplePipeline, Debug) << "Frame duration " << us << " us: frame length " << frame
+				   << " (" << 1.0 / (frame * line) << " fps)";
+}
