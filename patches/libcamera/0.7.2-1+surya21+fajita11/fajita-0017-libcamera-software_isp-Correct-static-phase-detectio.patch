new file mode 100644
index 0000000..6015b74
--- /dev/null
+++ b/src/libcamera/software_isp/pdaf_pixels.cpp
@@ -0,0 +1,266 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Pascal Garber
+ *
+ * Correction of static phase-detection pixels in raw frames
+ */
+
+#include "libcamera/internal/software_isp/pdaf_pixels.h"
+
+#include <algorithm>
+#include <errno.h>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(PdafPixels)
+
+/**
+ * \file pdaf_pixels.h
+ * \brief Correction of static phase-detection pixels in raw frames
+ */
+
+/**
+ * \class PdafPixelCorrector
+ * \brief Replace uncorrected phase-detection pixels by their neighbours' mean
+ *
+ * Some sensors output their phase-detection pixels uncorrected, which breaks
+ * the statistics and leaves a dot pattern in the image. The corrector replaces
+ * the value of each such pixel, in place, with the rounded mean of its
+ * same-colour neighbours two pixels to the left, right, above and below,
+ * leaving out those outside the frame. As the colour of a site is not needed,
+ * the Bayer order does not matter.
+ *
+ * The neighbours are read as they are at that moment, so the sites must not be
+ * neighbours of each other, which CameraSensorProperties::PhaseDetectionPixels
+ * guarantees.
+ *
+ * The raw formats supported are 8 and 10 to 16 bits unpacked (in a 8-bit
+ * respectively little-endian 16-bit container) and 10 bits CSI-2 packed.
+ */
+
+namespace {
+
+/* 4 pixels in 5 bytes: bits 9..2 of pixel i in byte i, bits 1..0 in byte 4 */
+struct PixelCsi2Packed10 {
+	static unsigned int get(const uint8_t *row, unsigned int x)
+	{
+		const uint8_t *group = row + (x >> 2) * 5;
+		unsigned int i = x & 3;
+
+		return (group[i] << 2) | ((group[4] >> (2 * i)) & 3);
+	}
+
+	static void set(uint8_t *row, unsigned int x, unsigned int value)
+	{
+		uint8_t *group = row + (x >> 2) * 5;
+		unsigned int i = x & 3;
+
+		group[i] = value >> 2;
+		group[4] = (group[4] & ~(3 << (2 * i))) | ((value & 3) << (2 * i));
+	}
+};
+
+struct PixelRaw8 {
+	static unsigned int get(const uint8_t *row, unsigned int x)
+	{
+		return row[x];
+	}
+
+	static void set(uint8_t *row, unsigned int x, unsigned int value)
+	{
+		row[x] = value;
+	}
+};
+
+struct PixelRaw16 {
+	static unsigned int get(const uint8_t *row, unsigned int x)
+	{
+		return row[2 * x] | (row[2 * x + 1] << 8);
+	}
+
+	static void set(uint8_t *row, unsigned int x, unsigned int value)
+	{
+		row[2 * x] = value & 0xff;
+		row[2 * x + 1] = value >> 8;
+	}
+};
+
+} /* namespace */
+
+/**
+ * \brief Configure the correction for a raw frame format
+ * \param[in] pattern The phase-detection pixels of the sensor
+ * \param[in] size The size of the raw frames
+ * \param[in] stride The stride of the raw frames, in bytes
+ * \param[in] format The raw format of the frames
+ *
+ * The correction is enabled only if the pattern is not empty, \a size is equal
+ * to the output size the pattern was described for, and the format is
+ * supported. Otherwise it is disabled.
+ *
+ * Everything that depends on the pattern is computed here, so that correct()
+ * allocates nothing.
+ *
+ * \return 0 if the correction is enabled, -ENODEV if there is nothing to
+ * correct for these frames, -ENOTSUP if the format is not supported, -EINVAL
+ * if the stride is too small
+ */
+int PdafPixelCorrector::configure(const CameraSensorProperties::PhaseDetectionPixels &pattern,
+				  const Size &size, unsigned int stride,
+				  const BayerFormat &format)
+{
+	disable();
+
+	if (pattern.sites.empty() || pattern.period.isNull() ||
+	    size != pattern.outputSize)
+		return -ENODEV;
+
+	Format fmt = Format::None;
+	size_t rowBytes = 0;
+
+	if (format.packing == BayerFormat::Packing::CSI2 && format.bitDepth == 10) {
+		fmt = Format::Csi2Packed10;
+		rowBytes = (size.width + 3) / 4 * 5;
+	} else if (format.packing == BayerFormat::Packing::None &&
+		   format.bitDepth == 8) {
+		fmt = Format::Raw8;
+		rowBytes = size.width;
+	} else if (format.packing == BayerFormat::Packing::None &&
+		   format.bitDepth > 8 && format.bitDepth <= 16) {
+		fmt = Format::Raw16;
+		rowBytes = size.width * 2;
+	} else {
+		LOG(PdafPixels, Warning)
+			<< "Raw format " << format
+			<< " is not supported, not correcting phase-detection pixels";
+		return -ENOTSUP;
+	}
+
+	if (stride < rowBytes)
+		return -EINVAL;
+
+	std::vector<std::vector<unsigned int>> rowSites(pattern.period.height);
+	for (const Point &site : pattern.sites) {
+		if (site.x < 0 || site.y < 0 ||
+		    static_cast<unsigned int>(site.x) >= pattern.period.width ||
+		    static_cast<unsigned int>(site.y) >= pattern.period.height) {
+			LOG(PdafPixels, Warning)
+				<< "Ignoring phase-detection site " << site
+				<< " outside the " << pattern.period << " period";
+			continue;
+		}
+
+		rowSites[site.y].push_back(site.x);
+	}
+
+	for (auto &sites : rowSites)
+		std::sort(sites.begin(), sites.end());
+
+	format_ = fmt;
+	size_ = size;
+	stride_ = stride;
+	minDataSize_ = static_cast<size_t>(stride) * (size.height - 1) + rowBytes;
+	periodWidth_ = pattern.period.width;
+	rowSites_ = std::move(rowSites);
+
+	return 0;
+}
+
+/**
+ * \brief Disable the correction
+ */
+void PdafPixelCorrector::disable()
+{
+	format_ = Format::None;
+	rowSites_.clear();
+}
+
+/**
+ * \fn PdafPixelCorrector::isEnabled()
+ * \brief Check if the correction is enabled
+ * \return True if configure() enabled the correction
+ */
+
+/**
+ * \brief Correct the phase-detection pixels of a raw frame in place
+ * \param[in] data The mapped raw frame, which must be writable
+ *
+ * \return True if the frame was corrected, false if the correction is disabled
+ * or the buffer is too small for the configured frame
+ */
+bool PdafPixelCorrector::correct(Span<uint8_t> data) const
+{
+	if (!isEnabled() || data.size() < minDataSize_)
+		return false;
+
+	switch (format_) {
+	case Format::Csi2Packed10:
+		correctFrame<PixelCsi2Packed10>(data.data());
+		break;
+	case Format::Raw8:
+		correctFrame<PixelRaw8>(data.data());
+		break;
+	case Format::Raw16:
+		correctFrame<PixelRaw16>(data.data());
+		break;
+	case Format::None:
+		return false;
+	}
+
+	return true;
+}
+
+template<typename Pixel>
+void PdafPixelCorrector::correctFrame(uint8_t *data) const
+{
+	const unsigned int width = size_.width;
+	const unsigned int height = size_.height;
+	unsigned int tileRow = 0;
+
+	for (unsigned int y = 0; y < height; y++) {
+		const std::vector<unsigned int> &sites = rowSites_[tileRow];
+		if (++tileRow == rowSites_.size())
+			tileRow = 0;
+		if (sites.empty())
+			continue;
+
+		uint8_t *row = data + static_cast<size_t>(y) * stride_;
+		const uint8_t *above = y >= 2 ? row - 2 * static_cast<size_t>(stride_) : nullptr;
+		const uint8_t *below = y + 2 < height ? row + 2 * static_cast<size_t>(stride_) : nullptr;
+
+		for (unsigned int tileX = 0; tileX < width; tileX += periodWidth_) {
+			for (unsigned int siteX : sites) {
+				unsigned int x = tileX + siteX;
+				if (x >= width)
+					break;
+
+				unsigned int sum = 0;
+				unsigned int count = 0;
+
+				if (x >= 2) {
+					sum += Pixel::get(row, x - 2);
+					count++;
+				}
+				if (x + 2 < width) {
+					sum += Pixel::get(row, x + 2);
+					count++;
+				}
+				if (above) {
+					sum += Pixel::get(above, x);
+					count++;
+				}
+				if (below) {
+					sum += Pixel::get(below, x);
+					count++;
+				}
+
+				if (count)
+					Pixel::set(row, x, (sum + count / 2) / count);
+			}
+		}
+	}
+}
+
