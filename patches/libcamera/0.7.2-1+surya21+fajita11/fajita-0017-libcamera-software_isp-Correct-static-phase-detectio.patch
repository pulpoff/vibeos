diff --git a/test/pdaf-pixels.cpp b/test/pdaf-pixels.cpp
new file mode 100644
index 0000000..c98a797
--- /dev/null
+++ b/test/pdaf-pixels.cpp
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Copyright (C) 2026, Pascal Garber
+ *
+ * Phase-detection pixel correction tests
+ */
+
+#include <iostream>
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/camera_sensor_properties.h"
+#include "libcamera/internal/software_isp/pdaf_pixels.h"
+
+#include "test.h"
+
+using namespace std;
+using namespace libcamera;
+
+class PdafPixelsTest : public Test
+{
+protected:
+	static constexpr unsigned int kWidth = 64;
+	static constexpr unsigned int kHeight = 48;
+	static constexpr unsigned int kStride = 96;
+	static constexpr uint8_t kPadding = 0xa5;
+
+	static unsigned int get(const vector<uint8_t> &buf, unsigned int x, unsigned int y)
+	{
+		const uint8_t *g = &buf[y * kStride + (x >> 2) * 5];
+		unsigned int i = x & 3;
+
+		return (g[i] << 2) | ((g[4] >> (2 * i)) & 3);
+	}
+
+	static void set(vector<uint8_t> &buf, unsigned int x, unsigned int y, unsigned int v)
+	{
+		uint8_t *g = &buf[y * kStride + (x >> 2) * 5];
+		unsigned int i = x & 3;
+
+		g[i] = v >> 2;
+		g[4] = (g[4] & ~(3 << (2 * i))) | ((v & 3) << (2 * i));
+	}
+
+	static unsigned int gradient(unsigned int x, unsigned int y)
+	{
+		return 100 + 5 * x + 7 * y + ((x * 3 + y) & 3);
+	}
+
+	int run()
+	{
+		CameraSensorProperties::PhaseDetectionPixels pattern;
+		pattern.outputSize = { kWidth, kHeight };
+		pattern.period = { 16, 16 };
+		pattern.sites = { { 1, 1 }, { 9, 1 }, { 5, 5 }, { 13, 5 },
+				  { 5, 9 }, { 13, 9 }, { 1, 13 }, { 9, 13 } };
+
+		auto isSite = [&](unsigned int x, unsigned int y) {
+			for (const Point &p : pattern.sites)
+				if (x % 16 == static_cast<unsigned int>(p.x) &&
+				    y % 16 == static_cast<unsigned int>(p.y))
+					return true;
+			return false;
+		};
+
+		vector<uint8_t> buf(kStride * kHeight, kPadding);
+		for (unsigned int y = 0; y < kHeight; y++)
+			for (unsigned int x = 0; x < kWidth; x++)
+				set(buf, x, y, gradient(x, y));
+
+		/* Corrupt the sites by 1.7x */
+		for (unsigned int y = 0; y < kHeight; y++)
+			for (unsigned int x = 0; x < kWidth; x++)
+				if (isSite(x, y))
+					set(buf, x, y, gradient(x, y) * 17 / 10);
+
+		vector<uint8_t> corrupted = buf;
+
+		BayerFormat fmt(BayerFormat::RGGB, 10, BayerFormat::Packing::CSI2);
+		PdafPixelCorrector corrector;
+		if (corrector.configure(pattern, { kWidth, kHeight }, kStride, fmt)) {
+			cerr << "configure failed" << endl;
+			return TestFail;
+		}
+
+		if (corrector.configure(pattern, { kWidth, kHeight + 2 }, kStride, fmt) == 0 ||
+		    corrector.isEnabled()) {
+			cerr << "mismatching size must disable the correction" << endl;
+			return TestFail;
+		}
+
+		if (corrector.configure(pattern, { kWidth, kHeight }, kStride, fmt)) {
+			cerr << "re-configure failed" << endl;
+			return TestFail;
+		}
+
+		if (!corrector.correct({ buf.data(), buf.size() })) {
+			cerr << "correct() did nothing" << endl;
+			return TestFail;
+		}
+
+		for (unsigned int y = 0; y < kHeight; y++) {
+			for (unsigned int x = 0; x < kWidth; x++) {
+				unsigned int v = get(buf, x, y);
+
+				if (!isSite(x, y)) {
+					if (v != get(corrupted, x, y)) {
+						cerr << "non-site pixel " << x << "," << y << " changed" << endl;
+						return TestFail;
+					}
+					continue;
+				}
+
+				unsigned int sum = 0, n = 0;
+				if (x >= 2) { sum += get(corrupted, x - 2, y); n++; }
+				if (x + 2 < kWidth) { sum += get(corrupted, x + 2, y); n++; }
+				if (y >= 2) { sum += get(corrupted, x, y - 2); n++; }
+				if (y + 2 < kHeight) { sum += get(corrupted, x, y + 2); n++; }
+				unsigned int expected = (sum + n / 2) / n;
+
+				if (v != expected) {
+					cerr << "site " << x << "," << y << " is " << v
+					     << ", expected " << expected << endl;
+					return TestFail;
+				}
+			}
+
+			for (unsigned int i = (kWidth / 4) * 5; i < kStride; i++)
+				if (buf[y * kStride + i] != kPadding) {
+					cerr << "padding changed in row " << y << endl;
+					return TestFail;
+				}
+		}
+
+		/* Edge sites, e.g. (1,1) and (1,13) in column 1, have only 3 neighbours */
+		if (get(buf, 1, 1) != (get(corrupted, 3, 1) + get(corrupted, 1, 3) + 1) / 2) {
+			cerr << "corner site did not use in-frame neighbours only" << endl;
+			return TestFail;
+		}
+
+		/* Unsupported format is rejected */
+		BayerFormat fmt12(BayerFormat::RGGB, 12, BayerFormat::Packing::CSI2);
+		if (corrector.configure(pattern, { kWidth, kHeight }, kStride, fmt12) == 0) {
+			cerr << "unsupported format accepted" << endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(PdafPixelsTest)
