+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Pascal Garber
+ *
+ * Correction of static phase-detection pixels in raw frames
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <vector>
+
+#include <libcamera/base/span.h>
+
+#include <libcamera/geometry.h>
+
+#include "libcamera/internal/bayer_format.h"
+#include "libcamera/internal/camera_sensor_properties.h"
+
+namespace libcamera {
+
+class PdafPixelCorrector
+{
+public:
+	int configure(const CameraSensorProperties::PhaseDetectionPixels &pattern,
+		      const Size &size, unsigned int stride,
+		      const BayerFormat &format);
+	void disable();
+
+	bool isEnabled() const { return format_ != Format::None; }
+
+	bool correct(Span<uint8_t> data) const;
+
+private:
+	enum class Format {
+		None,
+		Raw8,
+		Raw16,
+		Csi2Packed10,
+	};
+
+	template<typename Pixel>
+	void correctFrame(uint8_t *data) const;
+
+	Format format_ = Format::None;
+	Size size_;
+	unsigned int stride_ = 0;
+	size_t minDataSize_ = 0;
+	unsigned int periodWidth_ = 0;
+	/* The x coordinates of the sites in a tile, for each row of the tile */
+	std::vector<std::vector<unsigned int>> rowSites_;
+};
+
+} /* namespace libcamera */
