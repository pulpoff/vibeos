diff --git a/test/ipa/soft_simple_agc.cpp b/test/ipa/soft_simple_agc.cpp
new file mode 100644
index 0000000..1d956f7
--- /dev/null
+++ b/test/ipa/soft_simple_agc.cpp
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Software ISP auto exposure algorithm test
+ */
+
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/software_isp/swisp_stats.h"
+#include "libcamera/internal/value_node.h"
+
+#include "algorithms/agc.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace ipa::soft;
+
+class SoftSimpleAgcTest : public Test
+{
+protected:
+	static constexpr uint32_t kPixels = 10000;
+	/* 16 of 256: the histogram's first 4 of 64 bins are below black */
+	static constexpr uint8_t kBlack = 16;
+
+	/*
+	 * the exposure asked for after one frame whose pixels sit in histogram bin `bin` above black (0 to 11 are the
+	 * first of the five MSV bins, mean (bin + 0.5) / 60), the fraction `upper` of them in bin 14 (the second): its
+	 * MSV is 1 + upper
+	 */
+	int32_t process(algorithms::Agc &agc, IPAContext &context, unsigned int bin, double upper, int32_t delivered)
+	{
+		SwIspStats stats{};
+		stats.valid = true;
+		stats.yHistogram[kBlack / 4 + bin] = static_cast<uint32_t>(kPixels * (1 - upper));
+		stats.yHistogram[kBlack / 4 + 14] += static_cast<uint32_t>(kPixels * upper);
+
+		IPAFrameContext &fc = context.frameContexts.alloc(frame_);
+		fc.sensor.exposure = delivered;
+		fc.sensor.gain = 1.0;
+		ControlList metadata(controls::controls);
+		agc.process(context, frame_, fc, &stats, metadata);
+		frame_++;
+		return fc.sensor.exposure;
+	}
+
+	int check(double target)
+	{
+		ValueNode tuning;
+		tuning.add("target", std::make_unique<ValueNode>(target));
+
+		IPAContext context(8);
+		/* as the IPA's configure() does */
+		context.activeState = {};
+		context.activeState.blc.level = kBlack;
+		auto &cfg = context.configuration.agc;
+		cfg.exposureMin = 4;
+		cfg.exposureMax = 3000;
+		cfg.againMin = 1.0;
+		cfg.againMax = 16.0;
+		cfg.again10 = 1.0;
+		cfg.againMinStep = 0.06;
+		cfg.lineDuration = std::chrono::microseconds(10);
+
+		algorithms::Agc agc;
+		if (agc.init(context, tuning)) {
+			std::cerr << "target " << target << " rejected" << std::endl;
+			return TestFail;
+		}
+
+		/*
+		 * All dark (the camera faces a table): the MSV reads 1.0, a hair below the target. The exposure jumps
+		 * by the most it may, 8x, instead of staying put (1.1) or creeping 1% a frame (1.3).
+		 */
+		int32_t e = process(agc, context, 0, 0, 100);
+		if (e != 800) {
+			std::cerr << "target " << target << ": dark frame asked for " << e << ", not 800" << std::endl;
+			return TestFail;
+		}
+
+		/* Until the sensor delivers it, the jump is asked for again, not made twice. */
+		e = process(agc, context, 0, 0, 100);
+		if (e != 800) {
+			std::cerr << "target " << target << ": undelivered jump became " << e << std::endl;
+			return TestFail;
+		}
+
+		/*
+		 * Delivered, the frame is still at the MSV's floor, its mean (bin 5, 0.092) below 80% of the target's
+		 * (0.12 or 0.16): the exposure jumps again, by the target's mean over the frame's, rather than stopping
+		 * there (1.1) or creeping (1.3).
+		 */
+		e = process(agc, context, 5, 0, 800);
+		const int32_t want = static_cast<int32_t>(800 * ((target - 0.5) / 5) / (5.5 / 60));
+		if (std::abs(e - want) > 1) {
+			std::cerr << "target " << target << ": half-dark frame asked for " << e << ", not " << want
+				  << std::endl;
+			return TestFail;
+		}
+
+		/* At the target (an MSV of 1.1 or 1.3, a mean of 0.14 or 0.16 above black) nothing changes. */
+		if (process(agc, context, 7, target - 1, e) != e) {
+			std::cerr << "target " << target << ": exposed frame moved the exposure" << std::endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+
+	int run() override
+	{
+		for (double target : { 1.1, 1.3 }) {
+			if (check(target) != TestPass)
+				return TestFail;
+		}
+		return TestPass;
+	}
+
+private:
+	uint32_t frame_ = 0;
+};
+
+TEST_REGISTER(SoftSimpleAgcTest)
-- 
