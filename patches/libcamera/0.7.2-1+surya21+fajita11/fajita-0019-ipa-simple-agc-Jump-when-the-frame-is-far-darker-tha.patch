From 23bc824e4bd766a108f34a73260c624d1d91cd45 Mon Sep 17 00:00:00 2001
From: Pascal Garber <pascal@artandcode.studio>
Date: Sat, 28 Nov 2026 19:13:16 +0100
Subject: [PATCH] ipa: simple: agc: Jump when the frame is far darker than the
 target

The 5-bin mean sample value cannot go below 1.0: with almost every
pixel in its lowest bin it no longer tells how dark the picture is.
With an exposure target close to that floor, an all-dark frame was not
far from the target: at 1.1 (the OnePlus 6T's IMX519) the error of 0.1
was within the hysteresis and the exposure never moved; at 1.3 it rose
by 1% a frame.

At the floor (an MSV below 1.05), let the mean decide: below 80% of the
target's mean the exposure jumps towards it as it does for a large MSV
error. Above the floor, and for targets of 2 and more, nothing changes.

test/ipa/soft_simple_agc checks targets 1.1 and 1.3: an all-dark frame
asks for 8x the exposure, the jump is asked for again until the sensor
delivers it, a frame still at the floor below 80% of the target's mean
jumps again, and a frame at the target changes nothing.
---
 src/ipa/simple/algorithms/agc.cpp |  14 +++-
 test/ipa/meson.build              |   6 ++
 test/ipa/soft_simple_agc.cpp      | 128 ++++++++++++++++++++++++++++++
 3 files changed, 146 insertions(+), 2 deletions(-)
 create mode 100644 test/ipa/soft_simple_agc.cpp

diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index b441795..eac4bf7 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -82,6 +82,15 @@ static constexpr double kMaxDigitalGain = 4.0;
 static constexpr float kExposureFar = 0.6;
 static constexpr double kExpMaxJump = 8.0;
 
+/*
+ * The MSV cannot go below 1.0: with almost every pixel in the lowest of its bins it no longer tells how dark the
+ * picture is, and with a target near 1.0 (1.1 on the OnePlus 6T's main camera) an all-dark frame was within
+ * kExposureSatisfactory and the exposure never moved. At that floor the mean decides: below this fraction of the
+ * target's mean the exposure jumps.
+ */
+static constexpr double kMsvFloor = 1.05;
+static constexpr double kMeanFarFraction = 0.8;
+
 Agc::Agc()
 	: exposureOptimal_(kDefaultExposureOptimal), meanOptimal_((kDefaultExposureOptimal - 0.5) / 5)
 {
@@ -112,11 +121,12 @@ void Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext, dou
 	double &again = frameContext.sensor.gain;
 
 	double error = exposureOptimal_ - exposureMSV;
+	const bool tooDark = exposureMSV < kMsvFloor && mean < meanOptimal_ * kMeanFarFraction;
 
-	if (std::abs(error) <= kExposureSatisfactory)
+	if (!tooDark && std::abs(error) <= kExposureSatisfactory)
 		return;
 
-	if (std::abs(error) >= kExposureFar) {
+	if (tooDark || std::abs(error) >= kExposureFar) {
 		auto &state = context.activeState.agc;
 		const auto &cfg = context.configuration.agc;
 
