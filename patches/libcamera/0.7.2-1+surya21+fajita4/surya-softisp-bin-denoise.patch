+/*
+ * 1.0 when the output is at least half the input's size or less: each output
+ * pixel then averages the 4x4 raw pixels under it (four Bayer quads) instead
+ * of demosaicing one raw pixel. The skipped pixels were all sensor noise
+ * thrown away; averaged, they take 2-3x of the noise out of the picture.
+ */
+uniform float bin;
+
+/* one raw pixel (its 8 high bits) at integer pixel coordinates p */
+float rawpx(vec2 p)
+{
+	return texture2D(tex_y, vec2(floor(BPP * p.x + 0.02) * tex_step.x, p.y * tex_step.y)).r;
+}
+
+/* the Bayer quad whose top left pixel is q (even coordinates) as RGB */
+vec3 quad(vec2 q)
+{
+	vec2 o = tex_bayer_first_red;
+	vec2 n = vec2(1.0) - o;
+	return vec3(rawpx(q + o),
+		    (rawpx(q + vec2(o.x, n.y)) + rawpx(q + vec2(n.x, o.y))) * 0.5,
+		    rawpx(q + n));
+}
 
