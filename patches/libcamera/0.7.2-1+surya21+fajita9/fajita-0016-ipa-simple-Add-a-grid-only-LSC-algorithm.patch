--- /dev/null
+++ b/test/ipa/soft_simple_lsc.cpp
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Software ISP lens shading correction algorithm test
+ */
+
+#include <iostream>
+#include <memory>
+#include <stdlib.h>
+#include <string>
+#include <unistd.h>
+
+#include <libcamera/base/file.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "algorithms/lsc.h"
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace ipa::soft;
+
+namespace {
+
+std::string gridLine(const char *name, int base)
+{
+	std::string s = std::string("      ") + name + ": [";
+	for (unsigned int i = 0; i < 17 * 17; i++)
+		s += (i ? ", " : "") + std::to_string(base + static_cast<int>(i % 5));
+	return s + "]\n";
+}
+
+} /* namespace */
+
+class SoftSimpleLscTest : public Test
+{
+protected:
+	int init() override
+	{
+		/* Two sets: 64 = 1.0 everywhere (+ a ripple), and 128 = 2.0. */
+		std::string yaml = "Lsc:\n  sets:\n    - ct: 3000\n";
+		yaml += gridLine("r", 60) + gridLine("g", 60) + gridLine("b", 60);
+		yaml += "    - ct: 6000\n";
+		yaml += gridLine("r", 120) + gridLine("g", 120) + gridLine("b", 120);
+
+		file_ = "/tmp/libcamera.test.XXXXXX";
+		int fd = mkstemp(&file_.front());
+		if (fd == -1)
+			return TestFail;
+		ssize_t ret = write(fd, yaml.data(), yaml.size());
+		close(fd);
+
+		return ret == static_cast<ssize_t>(yaml.size()) ? TestPass : TestFail;
+	}
+
+	void cleanup() override
+	{
+		unlink(file_.c_str());
+	}
+
+	bool prepare(algorithms::Lsc &lsc, IPAContext &context, unsigned int ct,
+		     DebayerParams &params, const ControlList &controls)
+	{
+		context.activeState.awb.temperatureK = ct;
+		IPAFrameContext &fc = context.frameContexts.alloc(frame_);
+		lsc.queueRequest(context, frame_, fc, controls);
+		lsc.prepare(context, frame_, fc, &params);
+		frame_++;
+		return true;
+	}
+
+	int run() override
+	{
+		File file(file_);
+		if (!file.open(File::OpenModeFlag::ReadOnly))
+			return TestFail;
+		std::unique_ptr<ValueNode> root = YamlParser::parse(file);
+		if (!root)
+			return TestFail;
+
+		IPAContext context(8);
+		algorithms::Lsc lsc;
+		if (lsc.init(context, (*root)["Lsc"]) || !context.lscEnabled) {
+			std::cerr << "init() failed" << std::endl;
+			return TestFail;
+		}
+		IPAConfigInfo info;
+		lsc.configure(context, info);
+
+		DebayerParams params;
+		ControlList none(controls::controls);
+
+		/* The default table is the identity: 64 = 1.0. */
+		if (params.lscLut[0] != 64 || params.lscLut[4] != 64) {
+			std::cerr << "default LUT is not the identity" << std::endl;
+			return TestFail;
+		}
+
+		/* Below the first set: that set, unchanged (ripple i % 5). */
+		prepare(lsc, context, 2000, params, none);
+		if (params.lscLut[0] != 60 || params.lscLut[4 * 1] != 61 ||
+		    params.lscLut[1] != 60 || params.lscLut[3] != 0 ||
+		    params.lscLutVersion != 1) {
+			std::cerr << "clamped low LUT wrong: " << int(params.lscLut[0])
+				  << " " << int(params.lscLut[4]) << " version "
+				  << params.lscLutVersion << std::endl;
+			return TestFail;
+		}
+
+		/* Halfway: (60 + 120) / 2 = 90 (+ ripple), 3 channels. */
+		prepare(lsc, context, 4500, params, none);
+		if (params.lscLut[0] != 90 || params.lscLut[4] != 91 ||
+		    params.lscLut[8] != 92 || params.lscLut[1] != 90 ||
+		    params.lscLut[2] != 90 || params.lscLut[3] != 0 ||
+		    params.lscLutVersion != 2) {
+			std::cerr << "interpolated LUT wrong: " << int(params.lscLut[0])
+				  << " " << int(params.lscLut[4]) << " version "
+				  << params.lscLutVersion << std::endl;
+			return TestFail;
+		}
+
+		/* A change below 100 K does not touch the table. */
+		prepare(lsc, context, 4550, params, none);
+		if (params.lscLutVersion != 2) {
+			std::cerr << "small change updated the LUT" << std::endl;
+			return TestFail;
+		}
+
+		/* Above the last set. */
+		prepare(lsc, context, 9000, params, none);
+		if (params.lscLut[0] != 120 || params.lscLutVersion != 3) {
+			std::cerr << "clamped high LUT wrong" << std::endl;
+			return TestFail;
+		}
+
+		/* Disabled by control: back to the identity. */
+		ControlList off(controls::controls);
+		off.set(controls::LensShadingCorrectionEnable, false);
+		prepare(lsc, context, 9000, params, off);
+		if (params.lscLut != DebayerParams::identityLscLut ||
+		    params.lscLutVersion != 4) {
+			std::cerr << "disabled LUT is not the identity" << std::endl;
+			return TestFail;
+		}
+
+		/* A tuning without sets is rejected. */
+		IPAContext context2(8);
+		algorithms::Lsc lsc2;
+		ValueNode empty;
+		if (lsc2.init(context2, empty) == 0) {
+			std::cerr << "empty tuning accepted" << std::endl;
+			return TestFail;
+		}
+
+		return TestPass;
+	}
+
+private:
+	std::string file_;
+	uint32_t frame_ = 0;
+};
+
+TEST_REGISTER(SoftSimpleLscTest)
-- 
