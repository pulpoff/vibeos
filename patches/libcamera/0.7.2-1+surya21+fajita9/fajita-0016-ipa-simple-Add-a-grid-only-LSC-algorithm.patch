diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 00ac3c6..f7e8977 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -45,7 +45,17 @@ struct DebayerParams {
 		kLscValuesPerCell * sizeof(uint8_t);
 	using LscLookupTable =
 		std::array<uint8_t, kLscGridSize * kLscGridSize * kLscValuesPerCell>;
-	alignas(4) LscLookupTable lscLut{};
+	static constexpr auto identityLscLut = [] {
+		LscLookupTable lut = {};
+		/* lut.fill(64) could be used, but it fails with older gcc versions */
+		for (size_t i = 0; kLscValuesPerCell * i < lut.size(); i++) {
+			lut[i * kLscValuesPerCell + 0] = 64; /* == UQ<2, 6>(1.0f).quantized() */
+			lut[i * kLscValuesPerCell + 1] = 64;
+			lut[i * kLscValuesPerCell + 2] = 64;
+		}
+		return lut;
+	}();
+	alignas(4) LscLookupTable lscLut = identityLscLut;
 	uint64_t lscLutVersion = 0;
 };
 
diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..c9d0bc2
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens shading correction
+ *
+ * The tuning file format and the way the grids reach the shader follow the
+ * upstream libcamera LSC algorithm by Xander Pronk, Rick ten Wolde and
+ * Milan Zamazal. This version does not use libipa's LscAlgorithm and
+ * supports tabular grids only.
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+namespace {
+
+constexpr unsigned int kGridSize = DebayerParams::kLscGridSize;
+constexpr unsigned int kTemperatureThreshold = 100;
+constexpr const char *kChannels[3] = { "r", "g", "b" };
+
+} /* namespace */
+
+int Lsc::init(IPAContext &context, const ValueNode &tuningData)
+{
+	const std::string type = tuningData["type"].get<std::string>("table");
+	if (type != "table") {
+		LOG(IPASoftLsc, Error)
+			<< "Unsupported Lsc type '" << type << "'";
+		return -EINVAL;
+	}
+
+	const ValueNode &sets = tuningData["sets"];
+	if (!sets.isList()) {
+		LOG(IPASoftLsc, Error) << "'sets' not found in tuning file";
+		return -EINVAL;
+	}
+
+	sets_.clear();
+
+	for (const auto &set : sets.asList()) {
+		unsigned int ct = set["ct"].get<uint32_t>(0);
+		Components comp;
+
+		for (unsigned int c = 0; c < 3; c++) {
+			auto values = set[kChannels[c]].get<std::vector<float>>();
+			if (!values || values->size() != kGridSize * kGridSize) {
+				LOG(IPASoftLsc, Error)
+					<< "Set for " << ct << " K: '" << kChannels[c]
+					<< "' needs " << kGridSize * kGridSize
+					<< " values";
+				return -EINVAL;
+			}
+
+			for (float v : *values)
+				comp[c].push_back(std::clamp<long>(std::lround(v), 0, 255));
+		}
+
+		if (!sets_.try_emplace(ct, std::move(comp)).second) {
+			LOG(IPASoftLsc, Error)
+				<< "Multiple sets for " << ct << " K";
+			return -EINVAL;
+		}
+	}
+
+	if (sets_.empty()) {
+		LOG(IPASoftLsc, Error) << "No Lsc sets found";
+		return -EINVAL;
+	}
+
+	context.ctrlMap[&controls::LensShadingCorrectionEnable] =
+		ControlInfo(false, true, true);
+	context.lscEnabled = true;
+
+	return 0;
+}
+
+int Lsc::configure(IPAContext &context,
+		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	context.activeState.lsc.enabled = true;
+	lastAppliedCt_.reset();
+	identityApplied_ = false;
+
+	return 0;
+}
+
+void Lsc::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	const auto &enable = controls.get(controls::LensShadingCorrectionEnable);
+	if (enable && *enable != context.activeState.lsc.enabled) {
+		context.activeState.lsc.enabled = *enable;
+		LOG(IPASoftLsc, Debug)
+			<< (*enable ? "Enabling" : "Disabling") << " Lsc";
+	}
+
+	frameContext.lsc.enabled = context.activeState.lsc.enabled;
+}
+
+void Lsc::interpolate(unsigned int ct, DebayerParams::LscLookupTable &lut) const
+{
+	auto upper = sets_.lower_bound(ct);
+	const Components *a, *b;
+	double lambda = 0.0;
+
+	if (upper == sets_.begin()) {
+		a = b = &upper->second;
+	} else if (upper == sets_.end()) {
+		a = b = &std::prev(upper)->second;
+	} else {
+		auto lower = std::prev(upper);
+		a = &lower->second;
+		b = &upper->second;
+		if (upper->first != ct)
+			lambda = static_cast<double>(ct - lower->first) /
+				 (upper->first - lower->first);
+		else
+			a = b;
+	}
+
+	for (unsigned int i = 0; i < kGridSize * kGridSize; i++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			double v = (*a)[c][i] * (1.0 - lambda) + (*b)[c][i] * lambda;
+			lut[i * DebayerParams::kLscValuesPerCell + c] =
+				static_cast<uint8_t>(std::lround(v));
+		}
+		lut[i * DebayerParams::kLscValuesPerCell + 3] = 0; /* padding */
+	}
+}
+
+void Lsc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext, DebayerParams *params)
+{
+	if (!frameContext.lsc.enabled) {
+		if (!identityApplied_) {
+			params->lscLut = DebayerParams::identityLscLut;
+			params->lscLutVersion++;
+			identityApplied_ = true;
+			lastAppliedCt_.reset();
+			LOG(IPASoftLsc, Debug) << "Lsc disabled";
+		}
+		return;
+	}
+
+	const unsigned int ct = context.activeState.awb.temperatureK;
+	if (lastAppliedCt_ &&
+	    utils::abs_diff(ct, *lastAppliedCt_) < kTemperatureThreshold)
+		return;
+
+	interpolate(ct, params->lscLut);
+	params->lscLutVersion++;
+	identityApplied_ = false;
+	lastAppliedCt_ = ct;
+
+	LOG(IPASoftLsc, Debug)
+		<< "Lsc table updated for " << ct << " K (version "
+		<< params->lscLutVersion << ")";
+}
+
+void Lsc::process([[maybe_unused]] IPAContext &context,
+		  [[maybe_unused]] const uint32_t frame,
+		  IPAFrameContext &frameContext,
+		  [[maybe_unused]] const SwIspStats *stats,
+		  ControlList &metadata)
+{
+	metadata.set(controls::LensShadingCorrectionEnable,
+		     frameContext.lsc.enabled);
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
