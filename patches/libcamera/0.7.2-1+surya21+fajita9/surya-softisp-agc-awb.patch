 	 * Clamp max gain at 4.0, this also avoids 0 division.
 	 */
 	auto &gains = context.activeState.awb.gains;
+	const float greyR = sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r();
+	const float greyB = sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b();
+
+	/*
+	 * Debian/Mobian on the POCO X3 NFC: the full grey-world correction
+	 * turned a lamp-lit room blue-white and a yellow floor blue, and a
+	 * fresh estimate on every frame let the colours jump on a noisy
+	 * picture. Correct only part of the way, keep a little warmth, and
+	 * move towards each new estimate slowly.
+	 */
+	constexpr float kStrength = 0.65f;
+	constexpr float kWarmR = 1.05f, kWarmB = 0.92f;
+	constexpr float kSmoothing = 0.15f;
+	const float targetR = (1.0f + kStrength * (greyR - 1.0f)) * kWarmR;
+	const float targetB = (1.0f + kStrength * (greyB - 1.0f)) * kWarmB;
 	gains = { {
-		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+		gains.r() + kSmoothing * (targetR - gains.r()),
 		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+		gains.b() + kSmoothing * (targetB - gains.b()),
 	} };
 
 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
