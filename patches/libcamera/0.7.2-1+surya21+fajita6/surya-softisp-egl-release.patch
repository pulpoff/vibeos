@@ -79,11 +88,36 @@ eGL::eGL()
  */
 eGL::~eGL()
 {
+	cleanUp();
+}
+
+/**
+ * \brief Release the context, the surface and, with the last user, the display
+ *
+ * Called when the stream stops (on the thread the context was made on). Without it each start() created another
+ * context and none was ever destroyed: a session manager hosting the cameras (WirePlumber) kept 250 MB of GPU
+ * memory after the camera app had closed, and more with every opening.
+ */
+void eGL::cleanUp()
+{
+	if (display_ == EGL_NO_DISPLAY)
+		return;
+
+	eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
 	if (context_ != EGL_NO_CONTEXT)
 		eglDestroyContext(display_, context_);
-
 	if (surface_ != EGL_NO_SURFACE)
 		eglDestroySurface(display_, surface_);
+	context_ = EGL_NO_CONTEXT;
+	surface_ = EGL_NO_SURFACE;
+
+	{
+		std::lock_guard<std::mutex> lock(displayUsersLock);
+		if (displayUsers && --displayUsers == 0)
+			eglTerminate(display_);
+	}
+	eglReleaseThread();
+	display_ = EGL_NO_DISPLAY;
 }
 
