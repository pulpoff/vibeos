+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus for the software ISP (POCO X3 NFC: the IMX682 behind a DW9807 VCM)
+ */
+
+#pragma once
+
+#include <vector>
+
+#include <libcamera/controls.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase { Idle, Coarse, Fine, Focused };
+
+	void startScan(IPAContext &context, uint32_t frame);
+	void moveTo(IPAContext &context, int32_t position, uint32_t frame);
+	void finishScan(IPAContext &context, uint32_t frame);
+	bool step(IPAContext &context, uint32_t frame, double value);
+	double dioptres(int32_t position) const;
+	int32_t position(double dioptres) const;
+
+	int32_t min_ = 0, max_ = 0;
+	int32_t scanMin_ = 0;	/* the lowest code at which the lens moves (tuning scanMin) */
+	double maxDioptres_ = 10.0;
+	int32_t mode_ = 0;		/* controls::AfModeEnum */
+	int32_t state_ = 0;		/* controls::AfStateEnum */
+	Phase phase_ = Phase::Idle;
+
+	/* the scan: positions to visit, what each gave, where the lens went and when */
+	std::vector<int32_t> targets_;
+	size_t next_ = 0;
+	int32_t bestPos_ = 0;
+	double best_ = 0, worst_ = 0;
+	unsigned int fallen_ = 0;
+	int32_t coarseStep_ = 0;
+	uint32_t movedAt_ = 0;
+	uint32_t settle_ = 3;
+	int32_t approach_ = -1;	/* a position passed through on the way to the next target, or -1 */
+	bool waiting_ = false;
+
+	/* continuous mode: the focus measure where it settled, and how the scene has moved since */
+	double reference_ = 0;
+	double last_ = 0;
+	unsigned int changed_ = 0, steady_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
