+/*
+ * The focus measure for autofocus, on 10-bit packed Bayer data: in every group of 5 bytes the first 4 are the top 8
+ * bits of 4 pixels in a row. Over the middle third of the image, blocks of 4x4 pixels (a group, 4 rows: every colour
+ * in the same proportion) are summed and each is compared with its right and lower neighbour; the squared
+ * differences add up. At full resolution and the gain a room needs, single-pixel differences were all noise (a flat
+ * curve over the lens range); 4x4 blocks are close to the scale of the picture an app shows, where the sharp
+ * position stands out 3x. About 2 ms on a 4624x3472 frame.
+ */
+void SwStatsCpu::sharpness10P(const uint8_t *frame, SwIspStats &stats)
+{
+	const unsigned int w = window_.width, h = window_.height;
+	const unsigned int x0 = (window_.x + w / 3) & ~3u, x1 = (window_.x + 2 * w / 3) & ~3u;
+	const unsigned int y0 = (window_.y + h / 3) & ~1u, y1 = window_.y + 2 * h / 3;
+	const unsigned int b0 = x0 * 5 / 4, b1 = x1 * 5 / 4;
+	uint64_t sum = 0, level = 0;
+	uint32_t count = 0;
+
+	/* 4x4 pixel blocks (4 bytes of a group, 4 rows): the sum of each against its right and lower neighbour */
+	/*
+	 * Each block's sum on a square-root scale (x16): shot noise grows with the light, so in linear values the bright
+	 * parts' noise outweighed every edge in the dark ones; the square root evens it out (as an app's gamma does)
+	 */
+	static const std::array<uint16_t, 16 * 255 + 1> kRoot = [] {
+		std::array<uint16_t, 16 * 255 + 1> t{};
+		for (unsigned int i = 0; i < t.size(); i++)
+			t[i] = static_cast<uint16_t>(std::lround(16.0 * std::sqrt(static_cast<double>(i))));
+		return t;
+	}();
+	auto block = [&](const uint8_t *p) {
+		int t = 0;
+		for (unsigned int r = 0; r < 4; r++, p += stride_)
