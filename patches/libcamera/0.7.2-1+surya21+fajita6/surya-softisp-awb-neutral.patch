+/*
+ * Near-neutral pixels for the white balance: black-subtracted, neither dark nor near clipping, and with the gains in
+ * use within 25% of grey. A scene of one big colour (a blue folder filling the frame) then no longer pulls the white
+ * balance to its opposite: only what is already nearly white or grey says what white is.
+ */
+#define SWSTATS_NEUTRAL(div)                                                                  \
+	if (neutralGainR_) {                                                                  \
+		const int bl = static_cast<int>(neutralBlack_ * 255 * (div));                \
+		const int gg = static_cast<int>(g) - bl;                                      \
+		if (gg > 10 * (div) && static_cast<int>(g) < 235 * (div) &&                   \
+		    static_cast<int>(r) < 235 * (div) && static_cast<int>(b) < 235 * (div)) {  \
+			const int64_t rr = static_cast<int64_t>(static_cast<int>(r) - bl) * neutralGainR_; \
+			const int64_t bb = static_cast<int64_t>(static_cast<int>(b) - bl) * neutralGainB_; \
+			const int64_t g8 = static_cast<int64_t>(gg) * 256;                    \
+			const int64_t mx = std::max({ rr, g8, bb }), mn = std::min({ rr, g8, bb }); \
+			if (mn > 0 && mx * 4 < mn * 5) {                                      \
+				nR += r;                                                      \
+				nG += g;                                                      \
+				nB += b;                                                      \
+				nCount++;                                                     \
+			}                                                                     \
+		}                                                                             \
+	}
 
