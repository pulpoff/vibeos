 	stats.sum_.r() += sumR;     \
 	stats.sum_.g() += sumG;     \
-	stats.sum_.b() += sumB;
+	stats.sum_.b() += sumB;     \
+	stats.sumNeutral_.r() += nR; \
+	stats.sumNeutral_.g() += nG; \
+	stats.sumNeutral_.b() += nB; \
+	stats.neutralCount += nCount;
 
