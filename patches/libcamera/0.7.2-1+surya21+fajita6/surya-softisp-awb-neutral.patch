+/**
+ * \brief Set the white balance the ISP applies now, for the near-neutral sums
+ * \param[in] gains The colour gains (any scale: only their ratios to green count)
+ * \param[in] blackLevel The black level, 0..1 of the full range
+ */
+void SwStatsCpu::setNeutralParams(const RGB<float> &gains, float blackLevel)
+{
+	if (gains.g() <= 0.0f)
+		return;
+	neutralGainR_ = static_cast<unsigned int>(256.0f * gains.r() / gains.g());
+	neutralGainB_ = static_cast<unsigned int>(256.0f * gains.b() / gains.g());
+	neutralBlack_ = blackLevel;
+}
